      "voice": "Daniel"
    },
    {
      "index": 5,
      "start": 19.36,
      "end": 23.85,
      "duration": 3.161875,
      "tempo": 1,
      "text": "Choose a considered palette. Let texture add character.",
      "file": "05.wav",
      "voice": "Daniel"
    },
    {
      "index": 6,
      "start": 24.16,
      "end": 28.65,
      "duration": 4.178229,
      "tempo": 1,
      "text": "Keep the details that feel like you. Make dressing a small daily ritual.",
      "file": "06.wav",
      "voice": "Daniel"
    },
    {
      "index": 7,
      "start": 28.96,
      "end": 33.45,
      "duration": 3.57375,
      "tempo": 1,
      "text": "Dress for the day ahead. Turn inspiration into your own wardrobe.",
